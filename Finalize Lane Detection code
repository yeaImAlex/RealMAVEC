import cv2
import numpy as np
import utils
from Camera import Camera
from Keyboard import Keyboard1

kM = Keyboard1()

curveList = []
avgVal = 10


# PID Controller class
class PIDController:
    def __init__(self, kp, ki, kd):
        self.kp = kp
        self.ki = ki
        self.kd = kd
        self.previous_error = 0
        self.integral = 0

    def calculate(self, setpoint, current_value):
        # Error calculation
        error = setpoint - current_value

        # Proportional term
        proportional = self.kp * error

        # Integral term
        self.integral += error
        integral = self.ki * self.integral

        # Derivative term
        derivative = self.kd * (error - self.previous_error)

        # Update the previous error
        self.previous_error = error

        # PID output
        output = proportional + integral + derivative
        output = output / 100  # Normalizing the curve value
        output = np.clip(output, -0.6, 0.6)  # Limiting output to between -0.6 and 0.6
        return -output


# PID constants
kp = 1
ki = 0.0
kd = 0.0

# Initialize the PID controller
pid = PIDController(kp, ki, kd)


# Lane curve calculation function
def getLaneCurve(img, display=2):
    imgCopy = img.copy()
    imgResult = img.copy()

    #### STEP 1: Apply thresholding
    imgThres = utils.thresholding(img)

    #### STEP 2: Warp perspective
    hT, wT, c = img.shape
    points = utils.valTrackbars()
    imgWarp = utils.warpImg(imgThres, points, wT, hT)
    imgWarpPoints = utils.drawPoints(imgCopy, points)

    #### NEW STEP: Mask low columns with insignificant pixel counts
    imgWarpMasked = utils.maskLowColumns(imgWarp, threshold=20)  # Apply the masking function here

    #### STEP 3: Calculate curve
    middlePoint, imgHist = utils.getHistogram(imgWarpMasked, display=True, minPer=0.5, region=4)
    curveAveragePoint, imgHist = utils.getHistogram(imgWarpMasked, display=True, minPer=0.9)
    curveRaw = curveAveragePoint - middlePoint

    #### STEP 4: Average curve for smoothing
    curveList.append(curveRaw)
    if len(curveList) > avgVal:
        curveList.pop(0)
    curve = int(sum(curveList) / len(curveList))

    #### STEP 5: Visualization and Display
    if display != 0:
        imgInvWarp = utils.warpImg(imgWarpMasked, points, wT, hT, inv=True)
        imgInvWarp = cv2.cvtColor(imgInvWarp, cv2.COLOR_GRAY2BGR)
        imgInvWarp[0:hT // 3, 0:wT] = 0, 0, 0
        imgLaneColor = np.zeros_like(img)
        imgLaneColor[:] = 0, 255, 0
        imgLaneColor = cv2.bitwise_and(imgInvWarp, imgLaneColor)
        imgResult = cv2.addWeighted(imgResult, 1, imgLaneColor, 1, 0)
        midY = 450
        cv2.putText(imgResult, str(curve), (wT // 2 - 80, 85), cv2.FONT_HERSHEY_COMPLEX, 2, (255, 0, 255), 3)
        cv2.line(imgResult, (wT // 2, midY), (wT // 2 + (curve * 3), midY), (255, 0, 255), 5)
        cv2.line(imgResult, ((wT // 2 + (curve * 3)), midY - 25), (wT // 2 + (curve * 3), midY + 25), (0, 255, 0), 5)
        for x in range(-30, 30):
            w = wT // 20
            cv2.line(imgResult, (w * x + int(curve // 50), midY - 10),
                     (w * x + int(curve // 50), midY + 10), (0, 0, 255), 2)

    if display == 2:
        imgStacked = utils.stackImages(0.7, ([img, imgWarpPoints, imgWarp],
                                             [imgHist, imgLaneColor, imgResult]))
        cv2.imshow('ImageStack', imgStacked)
    elif display == 1:
        cv2.imshow('Result', imgResult)

    return curve


# Function that returns PID adjusted curve
def getPIDAdjustedCurve(img, desired_curve=0, display=2):
    current_curve = getLaneCurve(img, display)
    pid_output = pid.calculate(desired_curve, current_curve)
    return pid_output  # Return PID-adjusted curve


if __name__ == '__main__':
    C = Camera()
    intialTrackBarVals = [71, 216, 0, 330]
    utils.initializeTrackbars(intialTrackBarVals)
    while True:
        frame = C.show_video()
        if frame is None:
            break

        pid_curve = getPIDAdjustedCurve(frame, desired_curve=0, display=2)
        print(pid_curve)

        if kM.getKey('q'):
            break

